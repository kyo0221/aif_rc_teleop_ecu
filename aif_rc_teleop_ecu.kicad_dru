(version 1)
(rule "Isolated ground separation >= 6 mm"
  (condition "(A.NetName == 'GND' && B.NetName == '/CAN_Transeiver/GND_CAN') || (B.NetName == 'GND' && A.NetName == '/CAN_Transeiver/GND_CAN')")
  (constraint clearance (min 6mm)))
(rule "No non-ground vias under crystal"
  (condition "A.Type == 'Via' && A.NetName != 'GND' && A.intersectsArea('Crystal bottom no signal routing')")
  (constraint disallow via))
